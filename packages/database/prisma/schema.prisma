datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id                      String                      @id @default(uuid())
  firebaseUid             String                      @unique
  email                   String                      @unique
  username                String                      @unique
  displayName             String?
  dateOfBirth             String?
  profilePicture          String?
  activeWindowStart       DateTime
  activeWindowEnd         DateTime
  lastLogin               DateTime                    @default(now())
  currentStreak           Int                         @default(0)
  cumulativeScore         Int                         @default(0)
  dropsReceivedToday      Int                         @default(0)
  lastDropDate            DateTime                    @default(now())
  questionsAnswered       Int                         @default(0)
  correctAnswers          Int                         @default(0)
  subscriptionTier        SubscriptionTier            @default(FREE)
  isAutoRenewalEnabled    Boolean                     @default(false)
  subscriptionExpiresAt   DateTime?
  onDemandTokens          Int                         @default(0)
  referredById            String?
  points                  Int                         @default(0)
  preferences             Json?                       @default("{\"difficultyPercentages\": {\"EASY\": 20, \"MEDIUM\": 70, \"HARD\": 10}}")
  onboardingComplete      Boolean                     @default(false)
  devicePushToken         String?
  role                    Role                        @default(USER)
  drops                   UserDrop[]
  scores                  UserScore[]
  subscriptionHistory     UserSubscriptionHistory[]
  friendshipsInitiated    Friendship[]                @relation("UserFriendshipsInitiated")
  friendshipsAccepted     Friendship[]                @relation("UserFriendshipsAccepted")
  notificationPreferences UserNotificationPreference?
  userNotifications       UserNotification[]
  webPushSubscriptions    WebPushSubscription[]
  accountStatus           AccountStatus               @default(ACTIVE)
  scheduledDeletionAt     DateTime?
  deletionWarningSent     Boolean                     @default(false)
  createdAt               DateTime                    @default(now())
  ingestionJobs           IngestionJob[]
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING_DELETION
}

enum PeriodType {
  WEEKLY
  MONTHLY
  OVERALL
}

enum DropType {
  SPONTANEOUS
  ON_DEMAND
}

enum BonusPeriodType {
  WEEK
  MONTH
}

enum BonusRewardType {
  POINTS
  PREMIUM_DAYS
}

// Persistent score ledger — one row per user per period.
// Updated on every correct drop answer; bonus filled by cron at period end.
model UserScore {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id])
  userId      String
  periodType  PeriodType
  periodStart DateTime // Monday 00:00 for WEEKLY; 1st 00:00 for MONTHLY; fixed epoch for OVERALL
  periodEnd   DateTime? // Sunday 23:59 for WEEKLY; last day for MONTHLY; null for OVERALL
  baseScore   Int        @default(0)
  bonusScore  Int        @default(0)
  totalScore  Int        @default(0) // baseScore + bonusScore, updated in sync
  rank        Int? // populated by the bonus cron at period end
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, periodType, periodStart])
  @@index([periodType, periodStart])
}

model Friendship {
  id          String           @id @default(uuid())
  requester   User             @relation("UserFriendshipsInitiated", fields: [requesterId], references: [id])
  requesterId String
  addressee   User             @relation("UserFriendshipsAccepted", fields: [addresseeId], references: [id])
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@unique([requesterId, addresseeId])
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum AgeRating {
  ALL
  TEEN
  MATURE
}

enum SubscriptionTier {
  FREE
  PREMIUM
  PLUS
  TRIAL
}

enum SubscriptionSource {
  PURCHASE
  VAULT_ACTIVATION
  ADMIN_GRANT
  LEADERBOARD
  TRIAL
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  questions   Question[]
}

model Question {
  id              String          @id @default(uuid())
  categories      Category[]
  difficultyLevel DifficultyLevel
  questionText    String
  choices         Choice[]
  explanationText String?
  hintText        String?
  ageRating       AgeRating       @default(ALL)
  drops           UserDrop[]
}

model Choice {
  id         String   @id @default(uuid())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  text       String
  order      Int      @default(0)
  isCorrect  Boolean  @default(false)

  @@index([questionId])
}

model UserDrop {
  id                String    @id @default(uuid())
  user              User      @relation(fields: [userId], references: [id])
  userId            String
  question          Question  @relation(fields: [questionId], references: [id])
  questionId        String
  scheduledDropTime DateTime
  expirationTime    DateTime
  // Delivery state
  isViewed          Boolean   @default(false)
  isAnswered        Boolean   @default(false)
  wasCorrect        Boolean   @default(false)
  // Spaced repetition — when BullMQ was scheduled to fire this drop
  scheduledFor      DateTime
  createdAt         DateTime  @default(now())
  // Audit fields — recorded at answer time for dispute resolution & reports
  usedHint          Boolean   @default(false)
  hintCostDeducted  Int       @default(0)
  revealedAnswer    Boolean   @default(false)
  selectedChoiceId  String?
  dropType          DropType  @default(SPONTANEOUS)
  pointsAwarded     Int       @default(0)
  answeredAt        DateTime?
  // Set when user clicks "Reveal Question"; drives the per-difficulty answer countdown
  answerDeadline    DateTime?
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Stores app-wide configuration settings editable from the admin panel.
// dataType: "string" | "number" | "boolean"
model Setting {
  key       String   @id
  value     String
  dataType  String   @default("string")
  label     String?
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Staging table for AI-generated trivia questions pending admin review.
model PendingQuestion {
  id                 String          @id @default(uuid())
  topic              String
  categorySlugs      String[]
  difficultyLevel    DifficultyLevel
  suggestedText      String
  suggestedChoices   Json
  hint               String?
  explanation        String?
  status             String          @default("PENDING")
  rejectionReason    String?
  isDuplicate        Boolean         @default(false)
  aiQualityScore     Int?
  aiFeedback         String?
  ageRating          AgeRating       @default(ALL)
  replacesQuestionId String? // set when status = 'PENDING-DUPLICATE'; points to the live Question.id to replace on approval
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status, createdAt(sort: Asc)])
}

model BonusPlan {
  id           String          @id @default(uuid())
  title        String
  periodType   BonusPeriodType
  rewardType   BonusRewardType
  startDate    DateTime
  endDate      DateTime
  payoutValues Int[]

  @@index([startDate, endDate])
}

// Stores legal documents (Terms of Service, Privacy Policy) as markdown.
// slug is a stable identifier: 'terms' | 'privacy'
model LegalDocument {
  id        String   @id @default(uuid())
  slug      String   @unique // 'terms' | 'privacy'
  title     String
  content   String // Markdown content
  version   String   @default("1.0")
  updatedAt DateTime @updatedAt
  updatedBy String? // admin email who last saved
}

// Permanent history of background worker (BullMQ) job executions.
model JobLog {
  id        String   @id @default(uuid())
  jobId     String
  queueName String
  jobName   String
  status    String
  payload   Json
  result    Json?
  createdAt DateTime @default(now())

  @@index([queueName, createdAt(sort: Desc)])
  @@index([jobId])
}



// Append-only audit log of every admin action modifying user data.
model AdminAuditLog {
  id            String   @id @default(uuid())
  adminId       String // The ID of the admin who performed the action
  adminEmail    String? // Snapshotted admin email for convenience
  targetUserId  String // The ID of the user whose data was modified
  actionType    String // Enum or string (e.g., "USER_DROP_OVERRIDE", "SUBSCRIPTION_GRANT", "ACCOUNT_DELETION")
  resourceType  String // E.g., "USER", "SUBSCRIPTION", "DROPS"
  previousState Json? // The state of the data before the change
  newState      Json? // The state of the data after the change
  reason        String // Required text explaining why the change was made
  ipAddress     String? // The IP address of the admin
  userAgent     String? // The browser/device of the admin
  createdAt     DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([actionType])
  @@index([createdAt(sort: Desc)])
}

// Append-only audit log of every subscription tier change per user.
model UserSubscriptionHistory {
  id        String             @id @default(uuid())
  user      User               @relation(fields: [userId], references: [id])
  userId    String
  tier      SubscriptionTier
  source    SubscriptionSource
  startedAt DateTime
  expiresAt DateTime?
  createdAt DateTime           @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

// ============================================================================
// NOTIFICATION SYSTEM MODELS
// ============================================================================

// Notification types
enum NotificationType {
  TRIVIA_DROP
  SYSTEM_ANNOUNCEMENT
  SUBSCRIPTION_REMINDER
  OFFER_PROMOTION
  CREDIT_ALERT
  ADMIN_MESSAGE
}

// Delivery channels
enum NotificationChannel {
  PUSH_MOBILE
  PUSH_WEB
  EMAIL
}

// Target audience
enum NotificationAudience {
  ALL_USERS
  USER_SEGMENT
  SPECIFIC_USERS
}

// Notification status
enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
}

// Notification template for reusable messages
model NotificationTemplate {
  id            String                @id @default(uuid())
  name          String                @unique
  type          NotificationType
  title         String
  body          String
  emailSubject  String?
  emailHtml     String?
  channels      NotificationChannel[]
  isActive      Boolean               @default(true)
  variables     String[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  notifications Notification[]
}

// Main notification record (created by admin or system)
model Notification {
  id                String                @id @default(uuid())
  type              NotificationType
  audience          NotificationAudience
  title             String
  body              String
  data              Json?
  channels          NotificationChannel[]
  status            NotificationStatus    @default(DRAFT)
  scheduledAt       DateTime?
  sentAt            DateTime?
  createdBy         String?
  templateId        String?
  template          NotificationTemplate? @relation(fields: [templateId], references: [id])
  targetUserIds     String[]
  targetCriteria    Json?
  totalRecipients   Int                   @default(0)
  deliveredCount    Int                   @default(0)
  openedCount       Int                   @default(0)
  clickedCount      Int                   @default(0)
  userNotifications UserNotification[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, scheduledAt])
}

// Per-user notification inbox entry
model UserNotification {
  id             String       @id @default(uuid())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  pushDelivered  Boolean      @default(false)
  pushSentAt     DateTime?
  emailDelivered Boolean      @default(false)
  emailSentAt    DateTime?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  clickedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId, createdAt])
}

// User preferences for notification types
model UserNotificationPreference {
  id                        String   @id @default(uuid())
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                    String   @unique
  triviaDrop                Boolean  @default(true)
  systemAnnouncement        Boolean  @default(true)
  subscriptionReminder      Boolean  @default(true)
  offerPromotion            Boolean  @default(false)
  creditAlert               Boolean  @default(true)
  adminMessage              Boolean  @default(true)
  enablePushNotification    Boolean  @default(true)
  enableWebPushNotification Boolean  @default(false)
  enableEmailNotification   Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}

// Web push subscriptions (VAPID)
model WebPushSubscription {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String   @unique
  auth      String   @unique
  browser   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Delivery attempt log for debugging
model NotificationDeliveryLog {
  id             String              @id @default(uuid())
  notificationId String
  userId         String
  channel        NotificationChannel
  status         String
  error          String?
  metadata       Json?
  createdAt      DateTime            @default(now())

  @@index([notificationId, userId, channel])
}

// ============================================================================
// CRON JOB MANAGEMENT
// ============================================================================

model CronJob {
  id             String             @id @default(uuid())
  name           String             @unique
  cronExpression String
  isActive       Boolean            @default(true)
  lastRunAt      DateTime?
  lastRunResult  String? // 'SUCCESS', 'FAILED', 'TERMINATED'
  nextRunAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  executions     CronJobExecution[]
}

model CronJobExecution {
  id        String    @id @default(uuid())
  cronJobId String
  cronJob   CronJob   @relation(fields: [cronJobId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  result    String // 'SUCCESS', 'FAILED', 'TERMINATED'
  errorLogs String?   @db.Text
}

enum IngestionStatus {
  QUEUED
  PROCESSING
  PAUSED
  COMPLETED
  FAILED
}

enum ProcessType {
  QUESTION_EXTRACTION
  QUIZ_GENERATION
}

model IngestionJob {
  id               String          @id @default(uuid())
  adminId          String
  admin            User            @relation(fields: [adminId], references: [id])
  processType      ProcessType
  fileName         String
  fileSize         Int             // in bytes
  storagePath      String          // absolute path on the server host volume
  status           IngestionStatus @default(QUEUED)
  currentPhase     String?         // 'SCOUT', 'EXTRACTION', 'ENHANCEMENT', 'UPLOAD'
  progress         Int             @default(0) // phase-level progress 0-100
  overallProgress  Int             @default(0) // overall job progress 0-100 (weighted across all phases)
  totalQuestions   Int             @default(0) // populated during extraction/enhancement
  currentPage      Int?            // page currently being processed (lastProcessedImageIndex + 1)
  totalPages       Int?            // total pages in the PDF being processed
  questionsExtracted Int?          // questions.length across all statuses
  questionsUploaded  Int?          // questions with status=UPLOADED
  lastHeartbeatAt  DateTime?       // updated every 30s while PROCESSING; used to detect stalled jobs
  errorLogs        String?         @db.Text
  processedAt      DateTime?
  manifestData     Json?           // The config options previously stored in manifest.json (categorySlugs, topic, instructions)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

