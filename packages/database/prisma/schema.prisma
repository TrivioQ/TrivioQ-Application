datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String       @id @default(uuid())
  firebaseUid       String       @unique
  email             String       @unique
  username          String       @unique
  displayName       String?
  profilePicture    String?
  activeWindowStart DateTime
  activeWindowEnd   DateTime
  lastLogin         DateTime     @default(now())
  currentStreak     Int        @default(0)
  cumulativeScore   Int        @default(0)
  dropsReceivedToday Int       @default(0)
  lastDropDate      DateTime   @default(now())
  subscriptionTier  SubscriptionTier @default(FREE)
  preferences       Json?
  devicePushToken   String?
  role              Role         @default(USER)
  drops             UserDrop[]
  scores            UserScore[]
  friendshipsInitiated Friendship[] @relation("UserFriendshipsInitiated")
  friendshipsAccepted  Friendship[] @relation("UserFriendshipsAccepted")
}

enum Role {
  USER
  ADMIN
}

enum PeriodType {
  WEEKLY
  MONTHLY
  OVERALL
}

// Persistent score ledger — one row per user per period.
// Updated on every correct drop answer; bonus filled by cron at period end.
model UserScore {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id])
  userId      String
  periodType  PeriodType
  periodStart DateTime   // Monday 00:00 for WEEKLY; 1st 00:00 for MONTHLY; fixed epoch for OVERALL
  periodEnd   DateTime?  // Sunday 23:59 for WEEKLY; last day for MONTHLY; null for OVERALL
  baseScore   Int        @default(0)
  bonusScore  Int        @default(0)
  totalScore  Int        @default(0) // baseScore + bonusScore, updated in sync
  rank        Int?       // populated by the bonus cron at period end
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, periodType, periodStart])
  @@index([periodType, periodStart])
}

model Friendship {
  id          String   @id @default(uuid())
  requester   User     @relation("UserFriendshipsInitiated", fields: [requesterId], references: [id])
  requesterId String
  addressee   User     @relation("UserFriendshipsAccepted", fields: [addresseeId], references: [id])
  addresseeId String
  status      String   @default("PENDING") // e.g. PENDING, ACCEPTED
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  questions   Question[]
}

model Question {
  id              String          @id @default(uuid())
  categories      Category[]
  difficultyLevel DifficultyLevel
  questionText    String
  choices         Json
  correctAnswerId String
  explanationText String?
  hintText        String?
  drops           UserDrop[]
}

model UserDrop {
  id                String    @id @default(uuid())
  user              User      @relation(fields: [userId], references: [id])
  userId            String
  question          Question  @relation(fields: [questionId], references: [id])
  questionId        String
  scheduledDropTime DateTime
  expirationTime    DateTime
  isAnswered        Boolean   @default(false)
  wasCorrect        Boolean?
  // Audit fields — recorded at answer time for dispute resolution & reports
  usedHint          Boolean   @default(false)
  hintCostDeducted  Int       @default(0)
  revealedAnswer    Boolean   @default(false)
  selectedChoiceId  String?
  pointsAwarded     Int       @default(0)
  answeredAt        DateTime?
}
