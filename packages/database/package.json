{
  "name": "@trivioq/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db-push": "dotenv -e ../../.env -- prisma db push",
    "db-migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "make-admin": "dotenv -e ../../.env -- ts-node scripts/make-admin.ts",
    "seed-mock-data": "dotenv -e ../../.env -- ts-node scripts/seed-mock-data.ts",
    "seed-legal": "dotenv -e ../../.env -- ts-node scripts/seed-legal.ts",
    "seed-settings": "dotenv -e ../../.env -- ts-node scripts/seed-settings.ts",
    "seed-categories": "dotenv -e ../../.env -- ts-node scripts/seed-categories.ts",
    "seed-notifications": "dotenv -e ../../.env -- ts-node scripts/seed-notifications.ts",
    "seed-server": "pnpm db-push && pnpm seed-legal && pnpm seed-settings && pnpm seed-categories",
    "debug": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "prisma": "^5.14.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^8.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
