{
  "name": "@trivioq/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db-push": "prisma db push",
    "db-migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "make-admin": "ts-node -r dotenv/config scripts/make-admin.ts",
    "seed-mock-data": "ts-node -r dotenv/config scripts/seed-mock-data.ts",
    "seed-legal": "ts-node -r dotenv/config scripts/seed-legal.ts",
    "seed-settings": "ts-node -r dotenv/config scripts/seed-settings.ts",
    "seed-categories": "ts-node -r dotenv/config scripts/seed-categories.ts",
    "seed-server": "yarn db-push && yarn seed-legal && yarn seed-settings && yarn seed-categories",
    "debug": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "prisma": "^5.14.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
