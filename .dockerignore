# ── Version control ──────────────────────────────────────────────────────────
.git
.gitignore

# ── Node / package managers ───────────────────────────────────────────────────
node_modules
**/node_modules

# ── Build outputs ─────────────────────────────────────────────────────────────
dist
**/dist
.next
**/.next
out
**/out

# ── Turbo / TypeScript cache ──────────────────────────────────────────────────
.turbo
**/.turbo
*.tsbuildinfo
**/*.tsbuildinfo

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
**/.env
**/.env.*
firebase-service-account.json
**/firebase-service-account.json

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.vscode
.idea
.DS_Store
*.suo
*.swp

# ── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docs & misc ───────────────────────────────────────────────────────────────
docs
README.md
*.md
!apps/*/README.md

# ── Mobile app (not containerized) ────────────────────────────────────────────
apps/mobile
!apps/mobile/package.json

# ── Yarn Berry install state (rebuilt inside container) ───────────────────────
.yarn/install-state.gz
