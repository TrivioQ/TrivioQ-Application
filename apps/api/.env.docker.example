# Database
DATABASE_URL="postgresql://trivioq:password@localhost:5432/trivioq?schema=public"

# Server
PORT="3013"
NODE_ENV="development"

# Redis
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_URL="redis://127.0.0.1:6379"

# Firebase Admin SDK (FCM)
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"

# Email Service (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"

# Web Push (VAPID)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@trivioq.com"

# Sentry (optional)
ENABLE_SENTRY="false"

# AI Providers
GEMINI_API_KEY="your-gemini-api-key"
NVIDIA_API_KEY="your-nvidia-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"

# Ingestion runner
INGESTION_AI_PROVIDER="google"
INGESTION_DIR="ingestion"
INGESTION_SCOUT_PROVIDER="nvidia"
INGESTION_EXTRACTION_PROVIDER="nvidia"
INGESTION_ENHANCEMENT_PROVIDER="deepseek"
INGESTION_SCOUT_MODEL="mistralai/mistral-small-4-119b-2603"
INGESTION_EXTRACTION_MODEL="moonshotai/kimi-k2"
INGESTION_ENHANCEMENT_MODEL="deepseek-v4-flash"
INGESTION_SCOUT_CALL_DELAY_SEC="15"
INGESTION_EXTRACTION_CALL_DELAY_SEC="15"
INGESTION_ENHANCEMENT_CALL_DELAY_SEC="3"
INGESTION_SCOUT_TEMPERATURE="0.2"
INGESTION_EXTRACTION_TEMPERATURE="0.2"
INGESTION_ENHANCEMENT_TEMPERATURE="0.7"
INGESTION_EXTRACTION_BATCH_SIZE="2"