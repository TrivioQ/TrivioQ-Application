{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev src/index.ts",
    "start": "node dist/index.js",
    "start:cron": "node dist/cron.js",
    "start:scheduler": "node dist/workers/scheduler.js",
    "start:dispatcher": "node dist/workers/dispatcher.js",
    "start:drop-worker": "node dist/workers/drop-worker.js",
    "ingest": "ts-node-dev --respawn false src/ingest.ts",
    "ingest:reupload": "ts-node-dev --respawn false src/ingest.ts --reupload",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@bull-board/ui": "^7.1.5",
    "@google/genai": "^2.7.0",
    "@sentry/node": "^10.53.1",
    "@sentry/profiling-node": "^10.53.1",
    "@trivioq/database": "workspace:*",
    "@trivioq/shared-types": "workspace:*",
    "bullmq": "^5.75.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "firebase-admin": "^13.8.0",
    "ioredis": "^5.10.1",
    "node-cron": "^4.2.1",
    "pdf2pic": "^3.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
