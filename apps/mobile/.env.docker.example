# ------------------------------------------------------------------------------
# apps/mobile (React Native / Expo) - Docker / Build Example
# ------------------------------------------------------------------------------
# Note: Mobile app typically runs on device, not in Docker.
# These values are used when building the mobile app.

# API URL - Use your local IP or production URL
EXPO_PUBLIC_API_URL="http://192.168.1.100:3013"

# Firebase Configuration (Public - safe for mobile)
EXPO_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="trivioq.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="trivioq"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="trivioq.appspot.com"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
EXPO_PUBLIC_FIREBASE_APP_ID="your-app-id"
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Expo Project ID (for EAS Build / Push Notifications)
EXPO_PUBLIC_PROJECT_ID="your-expo-project-id"