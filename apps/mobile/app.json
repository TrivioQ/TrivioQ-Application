{
  "expo": {
    "name": "TrivioQ",
    "slug": "trivioq-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "@sentry/react-native",
        {
          "url": "https://sentry.io/",
          "authToken": "SENTRY_AUTH_TOKEN"
        }
      ]
    ]
  }
}
