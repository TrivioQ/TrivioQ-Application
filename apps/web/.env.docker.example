# ------------------------------------------------------------------------------
# apps/web (Next.js) - Docker Example
# ------------------------------------------------------------------------------
API_URL="http://api:3013"

# Firebase — SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix).
# These values never reach the browser bundle.
FIREBASE_API_KEY="your-firebase-api-key"
FIREBASE_PROJECT_ID="trivioq"

# Google OAuth 2.0 — SERVER-SIDE ONLY.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Public base URL of this app (used to build the OAuth callback URI).
APP_URL="http://localhost:3011"