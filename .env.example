# ==============================================================================
# DO NOT ADD SECRETS TO THIS FILE. 
# Copy this to .env in the respective app folders for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# packages/database & apps/api
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/trivioq?schema=public"

# ------------------------------------------------------------------------------
# apps/api
# ------------------------------------------------------------------------------
PORT="8080"
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"

# (Optional) For authenticating/bypassing custom Firebase Admin interactions
FIREBASE_SERVICE_ACCOUNT="{}"

# ------------------------------------------------------------------------------
# apps/web (Next.js)
# ------------------------------------------------------------------------------
# Server-only — used exclusively by the /api/[...slug] proxy Route Handler.
# Never sent to the browser bundle.
API_URL="http://localhost:8080"

# Firebase Client Credentials for Web
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# ------------------------------------------------------------------------------
# apps/mobile (Expo / React Native)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL="http://localhost:8080" # (or http://10.0.2.2:8080 for Android Emulator)

# Firebase Client Credentials for Mobile
EXPO_PUBLIC_FIREBASE_API_KEY="your-api-key"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
EXPO_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
