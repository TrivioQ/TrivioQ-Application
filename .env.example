# ==============================================================================
# TrivioQ — Root .env Template
# ==============================================================================
# Copy this file to .env in the ROOT of the repository and fill in the values.
# NEVER commit .env to version control.
# ==============================================================================

# ── Docker / Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=trivioq
POSTGRES_PASSWORD=                          # ← fill in a strong password
POSTGRES_DB=trivioq

# ── Cloudflare Tunnel ──────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=                    # ← from Cloudflare Zero Trust dashboard

# ── Shared (Database) ─────────────────────────────────────────────────────────
# Used by: apps/api, apps/admin, packages/database
# Local dev: matches docker-compose postgres service
DATABASE_URL="postgresql://trivioq:password@localhost:5432/trivioq?schema=public"

# ── Firebase Service Account ──────────────────────────────────────────────────
# Path to firebase-service-account.json on the HOST machine.
# The file is bind-mounted read-only into API containers as /secrets/firebase-service-account.json.
# Keep this file at the repo root (gitignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ── apps/api ──────────────────────────────────────────────────────────────────
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
ENABLE_SENTRY="false"
SENTRY_DSN=                          # ← API & admin/web server-side DSN from GlitchTip
NEXT_PUBLIC_SENTRY_DSN=              # ← web & admin browser-side DSN from GlitchTip
RESEND_API_KEY=

# ── GlitchTip (Self-hosted Error Tracking) ────────────────────────────────────
# Deploy via docker-compose. After first boot, create projects in the UI and
# copy the DSN values above (SENTRY_DSN, NEXT_PUBLIC_SENTRY_DSN, EXPO_PUBLIC_SENTRY_DSN).
# GlitchTip's DSNs are 100% Sentry-SDK compatible — no code changes needed.
#
# Generate a secret key: openssl rand -hex 32
GLITCHTIP_POSTGRES_DB=glitchtip
GLITCHTIP_SECRET_KEY=                # ← [REQUIRED] run: openssl rand -hex 32
GLITCHTIP_DOMAIN=http://localhost:8000   # ← set to https://logs.trivioq.com in production
GLITCHTIP_EMAIL_URL=                 # ← optional smtp://user:pass@host:port (alerts)
GLITCHTIP_DEFAULT_FROM_EMAIL=noreply@trivioq.com
# Admin account — created automatically on first boot. Signups are disabled.
GLITCHTIP_ADMIN_EMAIL=               # ← [REQUIRED] your login email
GLITCHTIP_ADMIN_PASSWORD=            # ← [REQUIRED] choose a strong password

# AI provider API keys
GEMINI_API_KEY="your-gemini-api-key"
NVIDIA_API_KEY="your-nvidia-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"

# Ingestion runner — provider and model configuration
INGESTION_AI_PROVIDER="google"             # Global fallback: google | nvidia | deepseek
INGESTION_DIR="ingestion"                  # Directory relative to apps/api/
INGESTION_SCOUT_PROVIDER="nvidia"
INGESTION_EXTRACTION_PROVIDER="nvidia"
INGESTION_ENHANCEMENT_PROVIDER="deepseek"
INGESTION_SCOUT_MODEL="mistralai/mistral-small-4-119b-2603"
INGESTION_EXTRACTION_MODEL="moonshotai/kimi-k2.6"
INGESTION_ENHANCEMENT_MODEL="deepseek-v4-flash"
INGESTION_SCOUT_CALL_DELAY_SEC="15"
INGESTION_EXTRACTION_CALL_DELAY_SEC="15"
INGESTION_ENHANCEMENT_CALL_DELAY_SEC="3"
INGESTION_SCOUT_TEMPERATURE="0.2"
INGESTION_EXTRACTION_TEMPERATURE="0.2"
INGESTION_ENHANCEMENT_TEMPERATURE="0.7"
INGESTION_EXTRACTION_BATCH_SIZE="2"

# ── apps/admin ────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — never exposed to the browser bundle
FIREBASE_API_KEY="your-firebase-api-key"   # ← from Firebase Console
API_URL="http://127.0.0.1:3013"

# ── apps/web ──────────────────────────────────────────────────────────────────
# API_URL and FIREBASE_API_KEY are shared with admin above
FIREBASE_PROJECT_ID="your-project-id"
GOOGLE_CLIENT_ID="your-google-client-id"   # ← from Google Cloud Console
GOOGLE_CLIENT_SECRET="your-google-client-secret"
APP_URL="http://localhost:3011"

# ── apps/mobile (Expo) ────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL="http://127.0.0.1:3013"
# (Use http://10.0.2.2:3013 for Android Emulator)
EXPO_PUBLIC_FIREBASE_API_KEY="your-api-key"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
EXPO_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID="G-1234567890"
EXPO_PUBLIC_SENTRY_DSN=              # ← mobile React Native DSN from GlitchTip
