# ==============================================================================
# TrivioQ — Docker Environment Variables Template
# ==============================================================================
# Target: AutomationServer @ 192.168.0.101
#
# INSTRUCTIONS:
#   1. Copy each section's variables into the correct .env file:
#        apps/api/.env
#        apps/web/.env
#        apps/admin/.env
#   2. Set the root-level variables in a .env file at the project root
#      (alongside docker-compose.yml) OR export them in your shell.
#   3. NEVER commit .env files to version control.
#   4. Copy apps/api/firebase-service-account.json onto the server.
#
# NOTE: Lines marked [REQUIRED] have no default — docker-compose will error
#       if they are empty.
# ==============================================================================


# ==============================================================================
# ROOT — docker-compose.yml reads these from the shell / root .env
# ==============================================================================

# PostgreSQL credentials  [REQUIRED]
POSTGRES_USER=trivioq
POSTGRES_PASSWORD=                          # ← fill in a strong password
POSTGRES_DB=trivioq

# Path to the Firebase service account JSON on the HOST (AutomationServer).
# The file will be bind-mounted read-only into the API container.
FIREBASE_SERVICE_ACCOUNT_PATH=./apps/api/firebase-service-account.json

# Cloudflare Tunnel Token for exposing the local server securely over HTTPS.
# Get this from your Cloudflare Zero Trust Dashboard (Tunnels page).
CLOUDFLARE_TUNNEL_TOKEN=TEST


# ==============================================================================
# apps/api/.env
# ==============================================================================

# Database (auto-overridden by docker-compose but needed if you run api locally)
DATABASE_URL=postgresql://trivioq:CHANGE_ME@postgres:5432/trivioq?schema=public

# Server port (must match Dockerfile EXPOSE and docker-compose ports)
PORT=3013

# Redis (use service name as host inside Docker network)
REDIS_HOST=redis
REDIS_PORT=6379

# Firebase Admin — provide EITHER the JSON string OR the file path.
# In Docker the file path /secrets/firebase-service-account.json is bind-mounted.
FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json

# Google Gemini API Key for AI workers
GEMINI_API_KEY=

# Sentry (optional — leave empty to disable)
ENABLE_SENTRY=false
SENTRY_DSN=


# ==============================================================================
# apps/web/.env
# ==============================================================================

# Internal API URL (container-to-container; do NOT use localhost)
API_URL=http://api:3013

# Public base URL of this app — used to build the Google OAuth callback URI.
# Replace with your domain or use the server IP for beta.
APP_URL=http://192.168.0.101:3011

# Firebase — SERVER-SIDE ONLY (never sent to the browser)
FIREBASE_API_KEY=                           # ← from Firebase Console
FIREBASE_PROJECT_ID=trivioq

# Google OAuth 2.0 — SERVER-SIDE ONLY
GOOGLE_CLIENT_ID=                           # ← from Google Cloud Console
GOOGLE_CLIENT_SECRET=                       # ← from Google Cloud Console

# Sentry (optional)
SENTRY_DSN=


# ==============================================================================
# apps/admin/.env
# ==============================================================================

# Database (direct Prisma connection — admin queries DB directly)
DATABASE_URL=postgresql://trivioq:CHANGE_ME@postgres:5432/trivioq?schema=public

# Internal API URL
API_URL=http://api:3013

# Firebase — SERVER-SIDE ONLY
FIREBASE_API_KEY=                           # ← from Firebase Console

# Sentry (optional)
SENTRY_DSN=
