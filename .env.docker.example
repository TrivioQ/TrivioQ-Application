# ==============================================================================
# TrivioQ — Docker Environment Variables Template
# ==============================================================================
# Target: AutomationServer @ 192.168.0.101
#
# INSTRUCTIONS:
#   1. Copy this file to .env in the ROOT of the repository (same directory
#      as docker-compose.yml).
#   2. Fill in all [REQUIRED] values.
#   3. Place firebase-service-account.json in the repo root.
#   4. NEVER commit .env or firebase-service-account.json to version control.
#
# NOTE: Lines marked [REQUIRED] have no default — docker-compose will error
#       if they are empty.
# ==============================================================================


# ==============================================================================
# PostgreSQL — used by docker-compose postgres service
# ==============================================================================

POSTGRES_USER=trivioq
POSTGRES_PASSWORD=                          # ← [REQUIRED] fill in a strong password
POSTGRES_DB=trivioq


# ==============================================================================
# Cloudflare Tunnel
# ==============================================================================

# Token for exposing the local server securely over HTTPS.
# Get this from your Cloudflare Zero Trust Dashboard (Tunnels page).
CLOUDFLARE_TUNNEL_TOKEN=                    # ← [REQUIRED]


# ==============================================================================
# Shared
# ==============================================================================

# Database — auto-overridden by docker-compose for container networking,
# but needed if you run apps locally against a Docker postgres.
DATABASE_URL=postgresql://trivioq:CHANGE_ME@postgres:5432/trivioq?schema=public

# Path to firebase-service-account.json on the HOST (AutomationServer).
# The file is bind-mounted read-only into API containers at /secrets/firebase-service-account.json.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json


# ==============================================================================
# apps/api
# ==============================================================================
# Redis (use Docker service name as host inside the Docker network)
REDIS_HOST=redis
REDIS_PORT=6379

# Firebase Admin service account (path is bind-mounted by docker-compose)
FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json

# Google Gemini API Key for AI workers  [REQUIRED]
GEMINI_API_KEY=

# NVIDIA API Key for ingestion           [REQUIRED if INGESTION_*_PROVIDER=nvidia]
NVIDIA_API_KEY=

# DeepSeek API Key for ingestion         [REQUIRED if INGESTION_*_PROVIDER=deepseek]
DEEPSEEK_API_KEY=

# Sentry (optional — leave empty to disable)
ENABLE_SENTRY=false
SENTRY_DSN=

# Ingestion runner
INGESTION_AI_PROVIDER=google
INGESTION_DIR=ingestion
INGESTION_SCOUT_PROVIDER=nvidia
INGESTION_EXTRACTION_PROVIDER=nvidia
INGESTION_ENHANCEMENT_PROVIDER=deepseek
INGESTION_SCOUT_MODEL=mistralai/mistral-small-4-119b-2603
INGESTION_EXTRACTION_MODEL=moonshotai/kimi-k2.6
INGESTION_ENHANCEMENT_MODEL=deepseek-v4-flash
INGESTION_SCOUT_CALL_DELAY_SEC=15
INGESTION_EXTRACTION_CALL_DELAY_SEC=15
INGESTION_ENHANCEMENT_CALL_DELAY_SEC=3
INGESTION_SCOUT_TEMPERATURE=0.2
INGESTION_EXTRACTION_TEMPERATURE=0.2
INGESTION_ENHANCEMENT_TEMPERATURE=0.7
INGESTION_EXTRACTION_BATCH_SIZE=2

# Email delivery  [REQUIRED for worker-email]
RESEND_API_KEY=


# ==============================================================================
# apps/web
# ==============================================================================

# Internal API URL (container-to-container; do NOT use localhost)
# Overridden by docker-compose environment: block — set here for local runs only.
API_URL=http://api:3013

# Public base URL — used to build the Google OAuth callback URI.
APP_URL=http://web:3011          # ← replace with your domain or server IP

# Firebase — SERVER-SIDE ONLY (never sent to the browser)
FIREBASE_API_KEY=                           # ← [REQUIRED] from Firebase Console
FIREBASE_PROJECT_ID=trivioq

# Google OAuth 2.0 — SERVER-SIDE ONLY
GOOGLE_CLIENT_ID=                           # ← [REQUIRED] from Google Cloud Console
GOOGLE_CLIENT_SECRET=                       # ← [REQUIRED] from Google Cloud Console

# Sentry (optional)
# SENTRY_DSN=


# ==============================================================================
# apps/admin
# ==============================================================================

# DATABASE_URL, API_URL, FIREBASE_API_KEY are shared above.


# ==============================================================================
# apps/mobile (Expo — build-time only, not used in Docker)
# ==============================================================================

EXPO_PUBLIC_API_URL=http://192.168.0.101:3013
EXPO_PUBLIC_FIREBASE_API_KEY=              # ← from Firebase Console
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=trivioq
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=trivioq.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
